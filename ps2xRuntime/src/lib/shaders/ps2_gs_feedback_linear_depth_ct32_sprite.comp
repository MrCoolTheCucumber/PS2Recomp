#version 450
#extension GL_GOOGLE_include_directive : require

#include "ps2_gs_memory.glsl"

// Texture reads come from an immutable run snapshot while color and depth
// reads/writes target canonical resident VRAM. Each 8x8 workgroup retains the
// exact sequential binary32 V recurrence used by the established linear path.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer GsVram
{
    uint words[];
} gs_vram;

layout(set = 0, binding = 3, std430) readonly buffer GsFeedbackSnapshot
{
    uint words[];
} gs_feedback;

layout(push_constant) uniform FeedbackLinearDepthSpriteParameters
{
    uint framebuffer_base_block;
    uint framebuffer_width;
    uint bounds_x0;
    uint bounds_y0;
    uint bounds_x1;
    uint bounds_y1;
    uint texture_base_block;
    uint texture_width;
    uint texture_mask_u;
    uint texture_mask_v;
    int fixed_base_u;
    int fixed_block_step_u;
    int fixed_lane_u0;
    int fixed_lane_u1;
    int fixed_lane_u2;
    int fixed_lane_u3;
    int fixed_lane_u4;
    int fixed_lane_u5;
    int fixed_lane_u6;
    int fixed_lane_u7;
    uint fixed_scan_v_bits;
    uint fixed_step_v_bits;
    uint texture_wrap_u;
    uint texture_wrap_v;
    uint depth_base_block;
    uint depth_psm;
    uint depth;
    uint depth_test_method;
    uint depth_write;
    uint texture_source;
    uint reserved0;
    uint reserved1;
} sprite;

shared float fixed_v_rows[8];

int fixed_lane_u(uint lane)
{
    switch (lane)
    {
    case 0u: return sprite.fixed_lane_u0;
    case 1u: return sprite.fixed_lane_u1;
    case 2u: return sprite.fixed_lane_u2;
    case 3u: return sprite.fixed_lane_u3;
    case 4u: return sprite.fixed_lane_u4;
    case 5u: return sprite.fixed_lane_u5;
    case 6u: return sprite.fixed_lane_u6;
    default: return sprite.fixed_lane_u7;
    }
}

int floor_fixed_16_16(int value)
{
    int quotient = value / 65536;
    if (value < 0 && (value % 65536) != 0)
        --quotient;
    return quotient;
}

uint wrap_texture_coordinate(int coordinate, uint mask, uint wrap)
{
    uint mode = wrap & 0x3u;
    if (mode == 0u)
        return uint(coordinate) & mask;
    return uint(clamp(coordinate, 0, int(mask)));
}

int floor_divide_16(int value)
{
    return value >= 0 ? value / 16 : -((-value + 15) / 16);
}

uint linear_color_4(uint from_color, uint to_color, uint weight)
{
    uint result = 0u;
    for (uint shift = 0u; shift < 32u; shift += 8u)
    {
        int from_channel = int((from_color >> shift) & 0xffu);
        int to_channel = int((to_color >> shift) & 0xffu);
        int channel = clamp(
            from_channel + floor_divide_16(
                (to_channel - from_channel) * int(weight)),
            0,
            255);
        result |= uint(channel) << shift;
    }
    return result;
}

uint read_feedback_ct32(uint u, uint v)
{
    uint bit_address = gs_pixel_bit_address(
        0x00u,
        sprite.texture_base_block,
        sprite.texture_width,
        u,
        v);
    uint word_index =
        (bit_address >> 5u) & (GS_MEMORY_WORD_COUNT - 1u);
    return gs_feedback.words[word_index];
}

uint gs_word_index(uint psm, uint base_block, uint x, uint y)
{
    uint bit_address = gs_pixel_bit_address(
        psm, base_block, sprite.framebuffer_width, x, y);
    return (bit_address >> 5u) & (GS_MEMORY_WORD_COUNT - 1u);
}

void write_z24(uint word_index, uint initial_word)
{
    uint expected = initial_word;
    for (;;)
    {
        uint replacement =
            (expected & 0xff000000u) | (sprite.depth & 0x00ffffffu);
        uint observed = atomicCompSwap(
            gs_vram.words[word_index], expected, replacement);
        if (observed == expected)
            return;
        expected = observed;
    }
}

void main()
{
    if (gl_LocalInvocationIndex == 0u)
    {
        precise float fixed_scan_v =
            uintBitsToFloat(sprite.fixed_scan_v_bits);
        precise float fixed_step_v =
            uintBitsToFloat(sprite.fixed_step_v_bits);
        uint tile_y = gl_WorkGroupID.y * 8u;
        for (uint offset_y = 0u; offset_y < tile_y; ++offset_y)
            fixed_scan_v = fixed_scan_v + fixed_step_v;
        for (uint row = 0u; row < 8u; ++row)
        {
            fixed_v_rows[row] = fixed_scan_v;
            fixed_scan_v = fixed_scan_v + fixed_step_v;
        }
    }
    barrier();

    uint offset_x = gl_GlobalInvocationID.x;
    uint offset_y = gl_GlobalInvocationID.y;
    uint width = sprite.bounds_x1 - sprite.bounds_x0;
    uint height = sprite.bounds_y1 - sprite.bounds_y0;
    if (offset_x >= width || offset_y >= height)
        return;

    uint x = sprite.bounds_x0 + offset_x;
    uint y = sprite.bounds_y0 + offset_y;
    uint depth_word_index = gs_word_index(
        sprite.depth_psm, sprite.depth_base_block, x, y);
    bool packed_z24 = sprite.depth_psm == 0x31u;
    bool needs_depth_word =
        sprite.depth_test_method >= 2u ||
        (packed_z24 && sprite.depth_write != 0u);
    uint depth_word = needs_depth_word
        ? atomicAdd(gs_vram.words[depth_word_index], 0u)
        : 0u;
    uint current_depth = packed_z24
        ? depth_word & 0x00ffffffu
        : depth_word;
    bool passes =
        sprite.depth_test_method == 1u ||
        (sprite.depth_test_method == 2u &&
         sprite.depth >= current_depth) ||
        (sprite.depth_test_method == 3u &&
         sprite.depth > current_depth);
    if (!passes)
        return;

    uint aligned_draw_x = sprite.bounds_x0 & ~7u;
    uint block = (x - aligned_draw_x) / 8u;
    uint fixed_u_bits =
        uint(sprite.fixed_base_u) +
        uint(fixed_lane_u(x & 7u)) +
        uint(sprite.fixed_block_step_u) * block;
    int fixed_u = int(fixed_u_bits);
    uint weight_u = (fixed_u_bits >> 12u) & 0x0fu;
    int unwrapped_u0 = floor_fixed_16_16(fixed_u);
    uint u0 = wrap_texture_coordinate(
        unwrapped_u0, sprite.texture_mask_u, sprite.texture_wrap_u);
    uint u1 = weight_u == 0u
        ? u0
        : wrap_texture_coordinate(
              unwrapped_u0 + 1,
              sprite.texture_mask_u,
              sprite.texture_wrap_u);

    int fixed_v = int(fixed_v_rows[gl_LocalInvocationID.y]);
    uint fixed_v_bits = uint(fixed_v);
    uint weight_v = (fixed_v_bits >> 12u) & 0x0fu;
    int unwrapped_v0 = floor_fixed_16_16(fixed_v);
    uint v0 = wrap_texture_coordinate(
        unwrapped_v0, sprite.texture_mask_v, sprite.texture_wrap_v);
    uint v1 = weight_v == 0u
        ? v0
        : wrap_texture_coordinate(
              unwrapped_v0 + 1,
              sprite.texture_mask_v,
              sprite.texture_wrap_v);

    uint c00 = read_feedback_ct32(u0, v0);
    uint color = c00;
    if (weight_u == 0u)
    {
        if (weight_v != 0u)
        {
            color = linear_color_4(
                c00, read_feedback_ct32(u0, v1), weight_v);
        }
    }
    else if (weight_v == 0u)
    {
        color = linear_color_4(
            c00, read_feedback_ct32(u1, v0), weight_u);
    }
    else
    {
        uint top = linear_color_4(
            c00, read_feedback_ct32(u1, v0), weight_u);
        uint bottom = linear_color_4(
            read_feedback_ct32(u0, v1),
            read_feedback_ct32(u1, v1),
            weight_u);
        color = linear_color_4(top, bottom, weight_v);
    }

    uint framebuffer_word_index = gs_word_index(
        0x00u, sprite.framebuffer_base_block, x, y);
    atomicExchange(gs_vram.words[framebuffer_word_index], color);
    if (sprite.depth_write == 0u)
        return;
    if (packed_z24)
        write_z24(depth_word_index, depth_word);
    else
        atomicExchange(gs_vram.words[depth_word_index], sprite.depth);
}
