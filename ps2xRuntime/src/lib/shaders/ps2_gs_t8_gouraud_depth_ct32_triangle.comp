#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float64 : require
#extension GL_ARB_gpu_shader_fp64 : require

#include "ps2_gs_memory.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer GsVram
{
    uint words[];
} gs_vram;

struct T8GouraudDepthTriangle
{
    uint framebuffer_base_block;
    uint framebuffer_width;
    uint bounds_x0;
    uint bounds_y0;
    uint bounds_x1;
    uint bounds_y1;
    uint depth_base_block;
    uint depth_psm;
    uint positive_area;
    uint top_left_edge_mask;
    int vertex_x_12_4[3];
    int vertex_y_12_4[3];
    uint vertex_z[3];
    uint rgba[3];
    uint vertex_fog;
    uint fog_color;
    uint scaled_s_bits[3];
    uint scaled_t_bits[3];
    uint q_bits[3];
    uint color_dx_bits[4];
    uint color_dy_bits[4];
    uint fog_dx_bits;
    uint fog_dy_bits;
    uint texture_dx_bits[3];
    uint texture_dy_bits[3];
    uint depth_dx_bits[2];
    uint depth_dy_bits[2];
    uint palette_index;
    uint raster_flags;
    uint reserved;
    uint texture_base_blocks[8];
    uint texture_widths[8];
    uint texture_width_log2;
    uint texture_height_log2;
    uint maximum_mip_level;
    uint texture_wrap_u;
    uint texture_wrap_v;
    int lod_k;
    uint lod_l;
    uint alpha_reference;
};

layout(set = 0, binding = 1, std430) readonly buffer TriangleRecords
{
    T8GouraudDepthTriangle records[];
} triangle_records;

// Resident batches are binned into ordered 8x8 tile lists by the host. Each
// four-word descriptor is {x, y, first, count}; the packed record indices
// begin at parameters.tile_index_words. Keeping every pixel's overlapping
// draws in one invocation preserves GS draw order without a dispatch and
// whole-VRAM barrier for every triangle.
layout(set = 0, binding = 2, std430) readonly buffer TileWork
{
    uint words[];
} tile_work;

layout(push_constant) uniform TriangleParameters
{
    uint record_index;
    uint tile_index_words;
    uint palette_index_words;
} parameters;

uint current_record_index;
#define triangle triangle_records.records[current_record_index]

uint palette_entry(uint index)
{
    return tile_work.words[
        parameters.palette_index_words +
        triangle.palette_index * 256u + index];
}

int64_t edge_value(
    int ax,
    int ay,
    int bx,
    int by,
    int sample_x,
    int sample_y)
{
    return
        (int64_t(bx) - int64_t(ax)) *
            (int64_t(sample_y) - int64_t(ay)) -
        (int64_t(by) - int64_t(ay)) *
            (int64_t(sample_x) - int64_t(ax));
}

int64_t oriented_edge_value(
    int ax,
    int ay,
    int bx,
    int by,
    int sample_x,
    int sample_y)
{
    int64_t value = edge_value(
        ax, ay, bx, by, sample_x, sample_y);
    return triangle.positive_area != 0u ? value : -value;
}

bool edge_covers(int64_t value, uint mask_bit)
{
    return value > int64_t(0) ||
           (value == int64_t(0) &&
            (triangle.top_left_edge_mask & mask_bit) != 0u);
}

bool sample_covered(int sample_x, int sample_y)
{
    int64_t edge0 = oriented_edge_value(
        triangle.vertex_x_12_4[1], triangle.vertex_y_12_4[1],
        triangle.vertex_x_12_4[2], triangle.vertex_y_12_4[2],
        sample_x, sample_y);
    int64_t edge1 = oriented_edge_value(
        triangle.vertex_x_12_4[2], triangle.vertex_y_12_4[2],
        triangle.vertex_x_12_4[0], triangle.vertex_y_12_4[0],
        sample_x, sample_y);
    int64_t edge2 = oriented_edge_value(
        triangle.vertex_x_12_4[0], triangle.vertex_y_12_4[0],
        triangle.vertex_x_12_4[1], triangle.vertex_y_12_4[1],
        sample_x, sample_y);
    return edge_covers(edge0, 1u) &&
           edge_covers(edge1, 2u) &&
           edge_covers(edge2, 4u);
}

void clip_span_to_edge(
    int64_t edge,
    int64_t step,
    bool top_left,
    inout int span_start,
    inout int span_end)
{
    int64_t threshold = top_left ? int64_t(0) : int64_t(1);
    if (step > int64_t(0))
    {
        if (edge < threshold)
        {
            int64_t delta = threshold - edge;
            int64_t first = (delta + step - int64_t(1)) / step;
            if (first >= int64_t(span_end))
                span_start = span_end;
            else
                span_start = max(span_start, int(first));
        }
    }
    else if (step < int64_t(0))
    {
        if (edge < threshold)
        {
            span_end = 0;
        }
        else
        {
            int64_t last = (edge - threshold) / -step;
            if (last < int64_t(span_end - 1))
                span_end = int(last + int64_t(1));
        }
    }
    else if (edge < threshold)
    {
        span_end = 0;
    }
}

int scanline_left(uint y)
{
    int sample_x = int(triangle.bounds_x0 << 4u);
    int sample_y = int(y << 4u);
    int64_t edge0 = oriented_edge_value(
        triangle.vertex_x_12_4[1], triangle.vertex_y_12_4[1],
        triangle.vertex_x_12_4[2], triangle.vertex_y_12_4[2],
        sample_x, sample_y);
    int64_t edge1 = oriented_edge_value(
        triangle.vertex_x_12_4[2], triangle.vertex_y_12_4[2],
        triangle.vertex_x_12_4[0], triangle.vertex_y_12_4[0],
        sample_x, sample_y);
    int64_t edge2 = oriented_edge_value(
        triangle.vertex_x_12_4[0], triangle.vertex_y_12_4[0],
        triangle.vertex_x_12_4[1], triangle.vertex_y_12_4[1],
        sample_x, sample_y);
    int64_t step0 =
        -int64_t(triangle.vertex_y_12_4[2] -
                 triangle.vertex_y_12_4[1]) * int64_t(16);
    int64_t step1 =
        -int64_t(triangle.vertex_y_12_4[0] -
                 triangle.vertex_y_12_4[2]) * int64_t(16);
    int64_t step2 =
        -int64_t(triangle.vertex_y_12_4[1] -
                 triangle.vertex_y_12_4[0]) * int64_t(16);
    if (triangle.positive_area == 0u)
    {
        step0 = -step0;
        step1 = -step1;
        step2 = -step2;
    }

    int span_start = 0;
    int span_end = int(triangle.bounds_x1 - triangle.bounds_x0);
    clip_span_to_edge(
        edge0, step0,
        (triangle.top_left_edge_mask & 1u) != 0u,
        span_start, span_end);
    clip_span_to_edge(
        edge1, step1,
        (triangle.top_left_edge_mask & 2u) != 0u,
        span_start, span_end);
    clip_span_to_edge(
        edge2, step2,
        (triangle.top_left_edge_mask & 4u) != 0u,
        span_start, span_end);
    return span_start < span_end
        ? int(triangle.bounds_x0) + span_start
        : int(triangle.bounds_x1);
}

void swap_uint(inout uint a, inout uint b)
{
    uint temporary = a;
    a = b;
    b = temporary;
}

uvec3 sorted_vertex_indices()
{
    uint top = 0u;
    uint middle = 1u;
    uint bottom = 2u;
    if (triangle.vertex_y_12_4[middle] <
        triangle.vertex_y_12_4[top])
    {
        swap_uint(top, middle);
    }
    if (triangle.vertex_y_12_4[bottom] <
        triangle.vertex_y_12_4[middle])
    {
        swap_uint(middle, bottom);
    }
    if (triangle.vertex_y_12_4[middle] <
        triangle.vertex_y_12_4[top])
    {
        swap_uint(top, middle);
    }
    return uvec3(top, middle, bottom);
}

uint scanline_base_index(uint y, uvec3 sorted)
{
    uint base = sorted.x;
    precise float top_x =
        float(triangle.vertex_x_12_4[sorted.x]) / 16.0f;
    precise float top_y =
        float(triangle.vertex_y_12_4[sorted.x]) / 16.0f;
    precise float middle_x =
        float(triangle.vertex_x_12_4[sorted.y]) / 16.0f;
    precise float middle_y =
        float(triangle.vertex_y_12_4[sorted.y]) / 16.0f;
    precise float bottom_x =
        float(triangle.vertex_x_12_4[sorted.z]) / 16.0f;
    precise float bottom_y =
        float(triangle.vertex_y_12_4[sorted.z]) / 16.0f;
    if (top_y == middle_y)
    {
        precise float flat_cross =
            (middle_y - top_y) * (bottom_x - top_x) -
            (middle_x - top_x) * (bottom_y - top_y);
        if (!(flat_cross < 0.0f))
            base = sorted.y;
    }
    else if (float(y) >= ceil(middle_y))
    {
        base = sorted.y;
    }
    return base;
}

precise vec4 unpack_fixed_color(uint rgba)
{
    return vec4(
        float(rgba & 0xffu),
        float((rgba >> 8u) & 0xffu),
        float((rgba >> 16u) & 0xffu),
        float(rgba >> 24u)) * 128.0f;
}

uint vertex_fog(uint index)
{
    return (triangle.vertex_fog >> (index * 8u)) & 0xffu;
}

int floor_divide_power_of_two(int value, int divisor)
{
    int quotient = value / divisor;
    if (value < 0 && (value % divisor) != 0)
        --quotient;
    return quotient;
}

int floor_fixed_16_16(int value)
{
    return floor_divide_power_of_two(value, 65536);
}

int wrap_coordinate(int coordinate, int size, uint mode)
{
    if (mode == 0u)
        return int(uint(coordinate) & uint(size - 1));
    return clamp(coordinate, 0, size - 1);
}

uint read_t8(uint base_block, uint width, int x, int y)
{
    uint bit_address = gs_pixel_bit_address(
        0x13u, base_block, width, uint(x), uint(y));
    uint word_index =
        (bit_address >> 5u) & (GS_MEMORY_WORD_COUNT - 1u);
    uint bit_shift = bit_address & 31u;
    uint word = atomicAdd(gs_vram.words[word_index], 0u);
    return (word >> bit_shift) & 0xffu;
}

ivec4 unpack_color(uint color)
{
    return ivec4(
        int(color & 0xffu),
        int((color >> 8u) & 0xffu),
        int((color >> 16u) & 0xffu),
        int(color >> 24u));
}

uint pack_color(ivec4 color)
{
    uvec4 value = uvec4(clamp(color, ivec4(0), ivec4(255)));
    return value.r |
           (value.g << 8u) |
           (value.b << 16u) |
           (value.a << 24u);
}

uint bilinear_color(
    uint c00,
    uint c10,
    uint c01,
    uint c11,
    int weight_u,
    int weight_v)
{
    ivec4 color00 = unpack_color(c00);
    ivec4 color10 = unpack_color(c10);
    ivec4 color01 = unpack_color(c01);
    ivec4 color11 = unpack_color(c11);
    ivec4 top = color00 + ((color10 - color00) * weight_u >> 4);
    ivec4 bottom = color01 + ((color11 - color01) * weight_u >> 4);
    return pack_color(top + ((bottom - top) * weight_v >> 4));
}

uint sample_linear_level(int fixed_u, int fixed_v, uint level)
{
    if (level != 0u)
    {
        int divisor = 1 << int(level);
        fixed_u = floor_divide_power_of_two(fixed_u, divisor);
        fixed_v = floor_divide_power_of_two(fixed_v, divisor);
    }
    if ((triangle.raster_flags & 16u) == 0u ||
        (triangle.raster_flags & 256u) != 0u)
    {
        fixed_u = int(uint(fixed_u) - 0x8000u);
        fixed_v = int(uint(fixed_v) - 0x8000u);
    }

    int weight_u = int((uint(fixed_u) >> 12u) & 0x0fu);
    int weight_v = int((uint(fixed_v) >> 12u) & 0x0fu);
    int u0 = floor_fixed_16_16(fixed_u);
    int v0 = floor_fixed_16_16(fixed_v);
    int texture_width = max(
        1, (1 << int(triangle.texture_width_log2)) >> int(level));
    int texture_height = max(
        1, (1 << int(triangle.texture_height_log2)) >> int(level));
    int wrapped_u0 = wrap_coordinate(
        u0, texture_width, triangle.texture_wrap_u);
    int wrapped_u1 = wrap_coordinate(
        u0 + 1, texture_width, triangle.texture_wrap_u);
    int wrapped_v0 = wrap_coordinate(
        v0, texture_height, triangle.texture_wrap_v);
    int wrapped_v1 = wrap_coordinate(
        v0 + 1, texture_height, triangle.texture_wrap_v);
    uint base_block = triangle.texture_base_blocks[level];
    uint width = triangle.texture_widths[level];
    uint c00 = palette_entry(read_t8(
        base_block, width, wrapped_u0, wrapped_v0));
    uint c10 = palette_entry(read_t8(
        base_block, width, wrapped_u1, wrapped_v0));
    uint c01 = palette_entry(read_t8(
        base_block, width, wrapped_u0, wrapped_v1));
    uint c11 = palette_entry(read_t8(
        base_block, width, wrapped_u1, wrapped_v1));
    return bilinear_color(
        c00, c10, c01, c11, weight_u, weight_v);
}

precise float approximate_log2_precision3(float value)
{
    uint bits = floatBitsToUint(value) & 0x7fffffffu;
    int exponent = int((bits >> 23u) & 0xffu) - 127;
    uint mantissa_bits = (bits & 0x007fffffu) | 0x3f800000u;
    precise float mantissa = uintBitsToFloat(mantissa_bits);
    precise float polynomial =
        0.204446009836232697516f * mantissa;
    polynomial = polynomial + -1.04913055217340124191f;
    polynomial = polynomial * mantissa;
    polynomial = polynomial + 2.28330284476918490682f;
    polynomial = polynomial * (mantissa - 1.0f);
    return polynomial + float(exponent);
}

uint sample_texture(int fixed_u, int fixed_v, float q)
{
    if (triangle.maximum_mip_level == 0u)
        return sample_linear_level(fixed_u, fixed_v, 0u);

    precise float absolute_q = max(abs(q), 1.17549435e-38f);
    precise float lod_scale =
        -float((1u << triangle.lod_l) * 65536u);
    precise float lod_bias = float(triangle.lod_k * 4096);
    precise float lod_value =
        approximate_log2_precision3(absolute_q) * lod_scale;
    lod_value = lod_value + lod_bias;
    precise float clamped_lod = clamp(
        lod_value,
        0.0f,
        float(triangle.maximum_mip_level) * 65536.0f);
    int lod_fixed = int(roundEven(clamped_lod));
    if (lod_fixed <= 0)
        return sample_linear_level(fixed_u, fixed_v, 0u);
    int rounded_lod = lod_fixed + 0x8000;
    uint level = uint(min(
        int(triangle.maximum_mip_level), rounded_lod >> 16));
    return sample_linear_level(fixed_u, fixed_v, level);
}

int modulate_channel(int texture, int vertex_fixed)
{
    int fixed_value = clamp(vertex_fixed, 0, 0x7fff);
    return clamp((texture * fixed_value) >> 14, 0, 255);
}

int fog_channel(int source, int fog, int factor)
{
    int difference = (source - fog) * factor;
    int delta = difference >= 0
        ? difference / 32768
        : -((-difference + 32767) / 32768);
    return clamp(fog + delta, 0, 255);
}

void decode_finite_float(
    uint bits,
    out uint significand,
    out int exponent)
{
    uint exponent_field = (bits >> 23u) & 0xffu;
    uint fraction = bits & 0x007fffffu;
    if (exponent_field != 0u)
    {
        significand = fraction | 0x00800000u;
        exponent = int(exponent_field) - 127;
        return;
    }
    if (fraction == 0u)
    {
        significand = 0u;
        exponent = -126;
        return;
    }

    int normalization_shift = 23 - findMSB(fraction);
    significand = fraction << normalization_shift;
    exponent = -126 - normalization_shift;
}

// Vulkan only bounds basic float division to an implementation-defined ULP
// tolerance. GS texture filtering, however, observes the truncated binary32
// quotient at 1/16-texel boundaries. Reproduce the host's round-to-nearest,
// ties-to-even IEEE quotient with integer arithmetic before truncating it.
int divide_float_to_int_exact(float numerator, float denominator)
{
    uint numerator_bits = floatBitsToUint(numerator);
    uint denominator_bits = floatBitsToUint(denominator);
    bool negative =
        ((numerator_bits ^ denominator_bits) & 0x80000000u) != 0u;
    uint numerator_significand = 0u;
    uint denominator_significand = 0u;
    int numerator_exponent = 0;
    int denominator_exponent = 0;
    decode_finite_float(
        numerator_bits & 0x7fffffffu,
        numerator_significand, numerator_exponent);
    decode_finite_float(
        denominator_bits & 0x7fffffffu,
        denominator_significand, denominator_exponent);
    if (numerator_significand == 0u)
        return 0;

    int quotient_exponent =
        numerator_exponent - denominator_exponent;
    uint dividend_shift = 23u;
    if (numerator_significand < denominator_significand)
    {
        --quotient_exponent;
        dividend_shift = 24u;
    }
    uint64_t dividend =
        uint64_t(numerator_significand) << dividend_shift;
    uint64_t divisor = uint64_t(denominator_significand);
    uint quotient_significand = uint(dividend / divisor);
    uint64_t remainder = dividend % divisor;
    uint64_t doubled_remainder = remainder << 1u;
    if (doubled_remainder > divisor ||
        (doubled_remainder == divisor &&
         (quotient_significand & 1u) != 0u))
    {
        ++quotient_significand;
    }
    if (quotient_significand == 0x01000000u)
    {
        quotient_significand = 0x00800000u;
        ++quotient_exponent;
    }

    if (quotient_exponent < 0)
        return 0;
    // cvttss2si, which implements the host cast, returns INT_MIN for every
    // positive overflow and for negative magnitudes beyond 2^31.
    if (quotient_exponent >= 31)
        return int(0x80000000u);
    uint magnitude = quotient_exponent >= 23
        ? quotient_significand << uint(quotient_exponent - 23)
        : quotient_significand >> uint(23 - quotient_exponent);
    return negative ? -int(magnitude) : int(magnitude);
}

uint gs_word_index(uint psm, uint base_block, uint x, uint y)
{
    uint bit_address = gs_pixel_bit_address(
        psm, base_block, triangle.framebuffer_width, x, y);
    return (bit_address >> 5u) & (GS_MEMORY_WORD_COUNT - 1u);
}

void write_z24(uint word_index, uint depth)
{
    uint expected = atomicAdd(gs_vram.words[word_index], 0u);
    for (;;)
    {
        uint replacement =
            (expected & 0xff000000u) | (depth & 0x00ffffffu);
        uint observed = atomicCompSwap(
            gs_vram.words[word_index], expected, replacement);
        if (observed == expected)
            return;
        expected = observed;
    }
}

void rasterize_pixel(uint record_index, uint x, uint y)
{
    current_record_index = record_index;
    if (x < triangle.bounds_x0 || y < triangle.bounds_y0 ||
        x >= triangle.bounds_x1 || y >= triangle.bounds_y1)
        return;
    int sample_x = int(x << 4u);
    int sample_y = int(y << 4u);
    if (!sample_covered(sample_x, sample_y))
        return;

    int left = scanline_left(y);
    if (left >= int(triangle.bounds_x1))
        return;
    uvec3 sorted = sorted_vertex_indices();
    uint base_index = scanline_base_index(y, sorted);
    precise float base_x =
        float(triangle.vertex_x_12_4[base_index]) / 16.0f;
    precise float base_y =
        float(triangle.vertex_y_12_4[base_index]) / 16.0f;
    precise float delta_y = float(y) - base_y;
    precise float prestep = float(left) - base_x;
    int scanline_skip = left & 7;
    int aligned_left = left & ~7;
    int block = (int(x) - aligned_left) / 8;
    int lane_offset = (int(x) & 7) - scanline_skip;

    double depth_dx = packDouble2x32(uvec2(
        triangle.depth_dx_bits[0], triangle.depth_dx_bits[1]));
    double depth_dy = packDouble2x32(uvec2(
        triangle.depth_dy_bits[0], triangle.depth_dy_bits[1]));
    double edge_depth = fma(
        depth_dy,
        double(delta_y),
        double(triangle.vertex_z[base_index]));
    double scanline_depth = fma(
        depth_dx, double(prestep), edge_depth);
    precise float depth_lane_delta =
        float(depth_dx) * float(lane_offset);
    double depth = scanline_depth + double(depth_lane_delta);
    double depth_block_delta = depth_dx * 8.0;
    for (int index = 0; index < block; ++index)
        depth += depth_block_delta;
    uint integer_depth = uint(depth);

    uint depth_word_index = 0u;
    if ((triangle.raster_flags & 2u) != 0u)
    {
        depth_word_index = gs_word_index(
            triangle.depth_psm, triangle.depth_base_block, x, y);
        uint destination_depth_word =
            atomicAdd(gs_vram.words[depth_word_index], 0u);
        uint destination_depth = triangle.depth_psm == 0x31u
            ? destination_depth_word & 0x00ffffffu
            : destination_depth_word;
        if (integer_depth < destination_depth)
            return;
    }

    precise vec4 color_dx = vec4(
        uintBitsToFloat(triangle.color_dx_bits[0]),
        uintBitsToFloat(triangle.color_dx_bits[1]),
        uintBitsToFloat(triangle.color_dx_bits[2]),
        uintBitsToFloat(triangle.color_dx_bits[3]));
    precise vec4 color_dy = vec4(
        uintBitsToFloat(triangle.color_dy_bits[0]),
        uintBitsToFloat(triangle.color_dy_bits[1]),
        uintBitsToFloat(triangle.color_dy_bits[2]),
        uintBitsToFloat(triangle.color_dy_bits[3]));
    precise vec4 edge_color = fma(
        color_dy,
        vec4(delta_y),
        unpack_fixed_color(triangle.rgba[base_index]));
    precise vec4 scanline_color_raw = fma(
        color_dx, vec4(prestep), edge_color);
    ivec4 scanline_color = ivec4(scanline_color_raw);
    ivec4 fixed_color =
        scanline_color +
        ivec4(color_dx * float(lane_offset)) +
        block * ivec4(color_dx * 8.0f);

    precise float fog_dx = uintBitsToFloat(triangle.fog_dx_bits);
    precise float fog_dy = uintBitsToFloat(triangle.fog_dy_bits);
    precise float edge_fog = fma(
        fog_dy,
        delta_y,
        float(vertex_fog(base_index)) * 128.0f);
    precise float scanline_fog_raw = fma(
        fog_dx, prestep, edge_fog);
    int fixed_fog =
        int(scanline_fog_raw) +
        int(fog_dx * float(lane_offset)) +
        block * int(roundEven(fog_dx * 8.0f));
    fixed_fog = clamp(fixed_fog, 0, 255 * 128);

    precise vec3 texture_dx = vec3(
        uintBitsToFloat(triangle.texture_dx_bits[0]),
        uintBitsToFloat(triangle.texture_dx_bits[1]),
        uintBitsToFloat(triangle.texture_dx_bits[2]));
    precise vec3 texture_dy = vec3(
        uintBitsToFloat(triangle.texture_dy_bits[0]),
        uintBitsToFloat(triangle.texture_dy_bits[1]),
        uintBitsToFloat(triangle.texture_dy_bits[2]));
    precise vec3 base_texture = vec3(
        uintBitsToFloat(triangle.scaled_s_bits[base_index]),
        uintBitsToFloat(triangle.scaled_t_bits[base_index]),
        uintBitsToFloat(triangle.q_bits[base_index]));
    precise vec3 edge_texture = fma(
        texture_dy, vec3(delta_y), base_texture);
    precise vec3 scanline_texture = fma(
        texture_dx, vec3(prestep), edge_texture);
    int fixed_u;
    int fixed_v;
    precise float lod_q;
    if ((triangle.raster_flags & 16u) != 0u)
    {
        // The no-mipmap constant-Q scanline path converts its base, lane,
        // and eight-pixel step independently before integer accumulation.
        // Delaying the conversion can cross a 1/16-texel filter boundary.
        uvec2 fixed_coordinates =
            uvec2(ivec2(scanline_texture.xy)) +
            uvec2(ivec2(texture_dx.xy * float(lane_offset))) +
            uvec2(ivec2(texture_dx.xy * 8.0f)) * uint(block);
        fixed_u = int(fixed_coordinates.x);
        fixed_v = int(fixed_coordinates.y);
        lod_q = 1.0f;
    }
    else
    {
        precise vec3 interpolated = scanline_texture +
            texture_dx * float(lane_offset);
        precise vec3 texture_block_step = texture_dx * 8.0f;
        for (int index = 0; index < block; ++index)
            interpolated = interpolated + texture_block_step;
        precise float safe_q =
            abs(interpolated.z) > 1.0e-8f
                ? interpolated.z
                : 1.0f;
        fixed_u = divide_float_to_int_exact(interpolated.x, safe_q);
        fixed_v = divide_float_to_int_exact(interpolated.y, safe_q);
        lod_q = interpolated.z;
    }
    ivec4 source;
    if ((triangle.raster_flags & 32u) != 0u)
    {
        // Untextured GS primitives pass the interpolated vertex color
        // directly to alpha test and blending in 8-bit channel space.
        source = clamp(
            fixed_color >> 7, ivec4(0), ivec4(255));
    }
    else
    {
        uint texel = sample_texture(fixed_u, fixed_v, lod_q);
        ivec4 texture_color = unpack_color(texel);
        source = ivec4(
            modulate_channel(texture_color.r, fixed_color.r),
            modulate_channel(texture_color.g, fixed_color.g),
            modulate_channel(texture_color.b, fixed_color.b),
            modulate_channel(texture_color.a, fixed_color.a));
    }
    if ((triangle.raster_flags & 1u) != 0u)
    {
        ivec3 fog_color = ivec3(
            int(triangle.fog_color & 0xffu),
            int((triangle.fog_color >> 8u) & 0xffu),
            int((triangle.fog_color >> 16u) & 0xffu));
        source.rgb = ivec3(
            fog_channel(source.r, fog_color.r, fixed_fog),
            fog_channel(source.g, fog_color.g, fixed_fog),
            fog_channel(source.b, fog_color.b, fixed_fog));
    }

    bool alpha_pass = uint(source.a) >= triangle.alpha_reference;
    if (!alpha_pass && (triangle.raster_flags & 128u) != 0u)
        return;
    uint framebuffer_word_index = gs_word_index(
        0x00u, triangle.framebuffer_base_block, x, y);
    uint destination =
        atomicAdd(gs_vram.words[framebuffer_word_index], 0u);
    ivec4 destination_color = unpack_color(destination);
    ivec3 blend_source =
        (triangle.raster_flags & 64u) != 0u
            ? source.rgb
            : source.rgb - destination_color.rgb;
    ivec3 blended = destination_color.rgb +
        (blend_source * source.a >> 7);
    source.rgb = clamp(blended, ivec3(0), ivec3(255));
    if (!alpha_pass && (triangle.raster_flags & 8u) != 0u)
        source.a = destination_color.a;
    atomicExchange(
        gs_vram.words[framebuffer_word_index], pack_color(source));

    if (alpha_pass && (triangle.raster_flags & 4u) != 0u)
    {
        if ((triangle.raster_flags & 2u) == 0u)
        {
            depth_word_index = gs_word_index(
                triangle.depth_psm, triangle.depth_base_block, x, y);
        }
        if (triangle.depth_psm == 0x31u)
            write_z24(depth_word_index, integer_depth);
        else
            atomicExchange(gs_vram.words[depth_word_index], integer_depth);
    }
}

void main()
{
    if (parameters.tile_index_words == 0u)
    {
        current_record_index = parameters.record_index;
        uint x = triangle.bounds_x0 + gl_GlobalInvocationID.x;
        uint y = triangle.bounds_y0 + gl_GlobalInvocationID.y;
        rasterize_pixel(parameters.record_index, x, y);
        return;
    }

    uint descriptor = gl_WorkGroupID.x * 4u;
    uint x = tile_work.words[descriptor] + gl_LocalInvocationID.x;
    uint y = tile_work.words[descriptor + 1u] + gl_LocalInvocationID.y;
    uint first = tile_work.words[descriptor + 2u];
    uint count = tile_work.words[descriptor + 3u];
    for (uint index = 0u; index < count; ++index)
    {
        uint record_index = tile_work.words[
            parameters.tile_index_words + first + index];
        rasterize_pixel(record_index, x, y);
    }
}
